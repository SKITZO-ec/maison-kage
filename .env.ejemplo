# Copia este archivo como .env y pon los datos de tu PostgreSQL
# Puerto donde escucha el sitio
PORT=3000
# Modo de ejecución, development o production
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maisonkage
DB_USER=postgres
DB_PASSWORD=tu_contraseña
# Intentos permitidos cada 15 minutos en las rutas sensibles
LIMITE_INTENTOS=5
# Dirección pública del sitio, se usa en los enlaces de los correos
URL_BASE=http://localhost:3000
# Datos de Gmail para enviar correos (clave de aplicación), opcional
# Si la clave queda vacía, los correos se imprimen en la consola del servidor
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
